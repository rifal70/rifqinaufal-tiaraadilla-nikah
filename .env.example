# Neon Serverless PostgreSQL Connection String
DATABASE_URL=postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Backblaze B2 Object Storage (Penyimpanan Foto, Galeri & Musik)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=wedding-gallery
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
# Opsional: Public bucket URL jika bucket diset publik
B2_PUBLIC_URL=

# Site URL for generating invitation links
NEXT_PUBLIC_SITE_URL=https://rifqinaufal-tiaraadilla-nikah.netlify.app

# Admin Credentials
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
